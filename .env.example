# Variables requeridas por deploy/compose.yml
# Copiar a .env y rellenar con valores reales (nunca commitear .env)

# Identidad de la base del dominio patient-management
PATIENT_DB_NAME=telemed_patient_db
PATIENT_DB_USER=telemed_patient_user
PATIENT_DB_PASSWORD=change-me-in-your-local-env

# (Opcional) Puerto publicado en el host, solo si necesitas conectarte desde fuera de Docker
# PATIENT_DB_HOST_PORT=5432